# Copie ce fichier en .env puis adapte-le
PORT=3000
# URL publique du panel (sans / final) : celle que les serveurs FiveM des clients appelleront
PUBLIC_URL=https://panel.mondomaine.fr
# Longue chaîne aléatoire (openssl rand -hex 32)
SESSION_SECRET=change-moi
# Compte administrateur créé au premier démarrage (change le mot de passe ensuite)
ADMIN_EMAIL=admin@mondomaine.fr
ADMIN_PASSWORD=ChangeMoi!2024
# true = les visiteurs peuvent créer un compte ; false = comptes créés par l'admin uniquement
ALLOW_REGISTER=true
# Jours d'essai offerts à l'inscription (0 = aucun essai)
TRIAL_DAYS=0
# Derrière nginx/Cloudflare : true
TRUST_PROXY=true
# Dossier de la base SQLite
DATA_DIR=./data
